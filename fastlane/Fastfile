default_platform(:ios)

platform :ios do
  desc "Build Outdoor Day for App Store"
  lane :build do
    build_app(
      project: "OutdoorDay.xcodeproj",
      scheme: "OutdoorDay",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "OutdoorDay.ipa"
    )
  end
end
